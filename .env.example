# ── LLM ──────────────────────────────────────────────────────────────────────
# Obtenir une clé sur https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Modèle à utiliser (ex: gpt-4o, gpt-4o-mini, gpt-3.5-turbo)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# ── Google Books API ─────────────────────────────────────────────────────────
# Optionnel – sans clé, quota limité à 1000 req/jour
# Obtenir une clé sur https://console.cloud.google.com/
GOOGLE_BOOKS_API_KEY=

# ── Données ──────────────────────────────────────────────────────────────────
# Chemin vers votre export Goodreads CSV
CSV_PATH=data/goodreads_library_export.csv
