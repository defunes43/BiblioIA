# ── LLM ──────────────────────────────────────────────────────────────────────
# Obtenir une clé sur https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Modèles à utiliser
ENRICHMENT_LLM_MODEL=gemini-2.0-flash
ENRICHMENT_LLM_TEMPERATURE=0.0

AGENT_LLM_MODEL=gemini-2.5-pro
AGENT_LLM_TEMPERATURE=0.7

# ── Google Books API ─────────────────────────────────────────────────────────
# Optionnel – sans clé, quota limité à 1000 req/jour
# Obtenir une clé sur https://console.cloud.google.com/
GOOGLE_BOOKS_API_KEY=

# ── Données ──────────────────────────────────────────────────────────────────
# Chemin vers votre export Goodreads CSV
CSV_PATH=data/goodreads_library_export.csv

# Tag utilisé pour marquer les livres très anciens (ex: lus pendant l'enfance)
# Ces livres verront leur date forcée à OLDER_BOOKS_YEARS_AGO pour ne pas écraser
# les recommandations récentes avec des biais trop forts.
OLDER_BOOKS_TAG=older_books
OLDER_BOOKS_YEARS_AGO=10

# Biais de récence (plus élevé = favorise davantage les lectures récentes)
RECENCY_DECAY_LAMBDA=0.2

# ── Performance fonctionnelle / ranking ──────────────────────────────────────
# Bonus appliqué aux livres dont les micro-genres recoupent tes tags dominants.
TOP_TAG_BOOST_FACTOR=0.35
TOP_TAG_COUNT=8

# ── Enrichissement ────────────────────────────────────────────────────────────
# Réenrichit automatiquement les lignes "Non classifié" / "Erreur LLM".
FORCE_REFRESH_UNCLASSIFIED=true

# Parallélisme et fréquence de sauvegarde pendant enrichissement.
ENRICHMENT_MAX_WORKERS=12
ENRICHMENT_SAVE_EVERY=50

# ── Presets recommandés ───────────────────────────────────────────────────────
# Copie-colle un preset dans ton .env selon ton objectif.
#
# [RAPIDE] (latence minimale, bon pour itérer souvent)
# ENRICHMENT_MAX_WORKERS=8
# ENRICHMENT_SAVE_EVERY=80
# TOP_TAG_BOOST_FACTOR=0.25
# TOP_TAG_COUNT=6
# RECENCY_DECAY_LAMBDA=0.18
#
# [EQUILIBRE] (par défaut conseillé)
# ENRICHMENT_MAX_WORKERS=12
# ENRICHMENT_SAVE_EVERY=50
# TOP_TAG_BOOST_FACTOR=0.35
# TOP_TAG_COUNT=8
# RECENCY_DECAY_LAMBDA=0.20
#
# [QUALITE_MAX] (meilleure finesse de ranking, plus coûteux en temps)
# ENRICHMENT_MAX_WORKERS=16
# ENRICHMENT_SAVE_EVERY=30
# TOP_TAG_BOOST_FACTOR=0.50
# TOP_TAG_COUNT=12
# RECENCY_DECAY_LAMBDA=0.24
