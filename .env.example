# ── LLM ──────────────────────────────────────────────────────────────────────
# Obtenir une clé sur https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Modèles à utiliser
ENRICHMENT_LLM_MODEL=gemini-2.0-flash
ENRICHMENT_LLM_TEMPERATURE=0.0

AGENT_LLM_MODEL=gemini-2.5-pro
AGENT_LLM_TEMPERATURE=0.7

# ── Google Books API ─────────────────────────────────────────────────────────
# Optionnel – sans clé, quota limité à 1000 req/jour
# Obtenir une clé sur https://console.cloud.google.com/
GOOGLE_BOOKS_API_KEY=

# ── Données ──────────────────────────────────────────────────────────────────
# Chemin vers votre export Goodreads CSV
CSV_PATH=data/goodreads_library_export.csv

# Tag utilisé pour marquer les livres très anciens (ex: lus pendant l'enfance)
# Ces livres verront leur date forcée à OLDER_BOOKS_YEARS_AGO pour ne pas écraser
# les recommandations récentes avec des biais trop forts.
OLDER_BOOKS_TAG=older_books
OLDER_BOOKS_YEARS_AGO=10
